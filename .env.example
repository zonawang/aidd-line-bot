# 請複製為 .env 並只在本機安全輸入專用憑證；不可貼到聊天、commit 或共享輸出。
# npm run dev 強制 synthetic demo，忽略 .env；npm start 使用此設定。
APP_MODE=demo
HOST=127.0.0.1
PORT=3000

# live 必須逐項具備實際授權；yes 是啟動檢查，不能替代權利與費用證據。
LIVE_AUTHORIZED=no
SOURCE_RIGHTS_CONFIRMED=no
GOOGLE_FEES_AUTHORIZED=no
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_DESTINATION=
GOOGLE_PLACES_API_KEY=

# 必須是公開可用、內容已審核的 HTTPS 條款／隱私頁面；需納入 Google 相應政策。
PUBLIC_TERMS_URL=
PUBLIC_PRIVACY_URL=
