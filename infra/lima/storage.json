{
  "minimumLimaVersion": "2.2.1",
  "vmType": "vz",
  "arch": "aarch64",
  "cpus": 2,
  "memory": "3GiB",
  "disk": "12GiB",
  "vmOpts": {
    "vz": { "diskImageFormat": "raw", "rosetta": { "enabled": false, "binfmt": false } }
  },
  "mounts": [],
  "networks": [],
  "containerd": { "system": false, "user": false },
  "upgradePackages": false,
  "ssh": {
    "loadDotSSHPubKeys": false,
    "forwardAgent": false,
    "forwardX11": false,
    "overVsock": true
  },
  "portForwards": [
    {
      "guestIP": "0.0.0.0",
      "guestIPMustBeZero": false,
      "proto": "any",
      "guestPortRange": [1, 65535],
      "ignore": true
    }
  ],
  "provision": [
    {
      "mode": "dependency",
      "skipDefaultDependencyResolution": true,
      "script": "#!/bin/sh\nset -eu\ncommand -v python3 >/dev/null\ncommand -v findmnt >/dev/null\ncommand -v lsblk >/dev/null\ncommand -v blockdev >/dev/null\n"
    }
  ]
}
